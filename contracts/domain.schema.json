{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "邻里课堂安全协作领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENROLLMENT_CONFIRMED",
        "STAFF_CLEARED",
        "SESSION_REASSIGNED",
        "PICKUP_CHANGED",
        "CASE_ESCALATED",
        "APPLICATION_SUBMITTED",
        "SITE_REGISTERED",
        "SITE_COORDINATOR_DESIGNATED",
        "SESSION_SCHEDULED",
        "SESSION_CANCELLED",
        "CARE_ARRANGEMENT_RECORDED",
        "GUARDIAN_AUTHORIZED",
        "PICKUP_RELATION_ADDED",
        "TEMP_PICKUP_REQUESTED",
        "STAFF_REGISTERED",
        "QUALIFICATION_RECORDED",
        "QUALIFICATION_EXPIRED",
        "STAFF_ABSENCE_REPORTED",
        "TASK_ASSIGNED",
        "TASK_RELEASED",
        "CHECK_IN_RECORDED",
        "CHECK_IN_BACKFILLED",
        "CHILD_ATTENDANCE_RECORDED",
        "OUTING_PLANNED",
        "OUTING_CONSENTED",
        "HOME_VISIT_SCHEDULED",
        "HOME_VISIT_COMPLETED",
        "TRANSFER_REQUESTED",
        "TRANSFER_CONFIRMED",
        "CASE_NOTE_ADDED",
        "CASE_STATUS_UPDATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "child_enrollment",
        "site_session",
        "staff_assignment",
        "safeguarding_case",
        "family_application",
        "site",
        "pickup_authorization",
        "attendance",
        "outing_plan",
        "home_visit",
        "transfer_request"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
